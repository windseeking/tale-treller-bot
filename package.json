{
  "name": "tg-trello-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot for creating Trello cards from user messages",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "mkdir -p dist/llm/prompts && cp src/llm/prompts/*.md dist/llm/prompts/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "pino": "^9.9.0",
    "telegraf": "^4.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}

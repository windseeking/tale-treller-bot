{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "..",
    "outDir": "../dist/app-ts",
    "types": ["vite/client"],
    "paths": {
      "@shared/i18n": ["../src/shared/i18n/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.json", "vite.config.ts", "../src/shared/i18n/**/*.ts"]
}

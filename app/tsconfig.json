{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "..",
    "outDir": "../dist/app-ts",
    "types": ["vite/client"],
    "paths": {
      "#interfaces/*": ["src/interfaces/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "../src/interfaces/**/*.ts"]
}
